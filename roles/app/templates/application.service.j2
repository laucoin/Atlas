[Unit]
Description=Atlas application: {{ app.name }}
After=network-online.target docker.service traefik.service
Requires=docker.service

[Service]
Type=simple
User={{ app_service_user }}
Group={{ app_service_user }}
WorkingDirectory={{ app_stack_dir }}/{{ app.name }}
Environment=DOCKER_HOST=unix:///run/user/{{ app_service_uid }}/docker.sock
ExecStart=/usr/bin/docker compose -f {{ app_stack_dir }}/{{ app.name }}/compose.yml up
ExecStop=/usr/bin/docker compose -f {{ app_stack_dir }}/{{ app.name }}/compose.yml down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

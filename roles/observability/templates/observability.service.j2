[Unit]
Description=Atlas stack: observability (victoriametrics + loki)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{ observability_service_user }}
Group={{ observability_service_user }}
WorkingDirectory={{ observability_stack_dir }}
Environment=DOCKER_HOST=unix:///run/user/{{ observability_service_uid }}/docker.sock
ExecStart=/usr/bin/docker compose -f {{ observability_stack_dir }}/compose.yml up
ExecStop=/usr/bin/docker compose -f {{ observability_stack_dir }}/compose.yml down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=Atlas stack: homeassistant
After=network-online.target docker.service traefik.service homeassistant-bridge.service
Requires=docker.service

[Service]
Type=simple
User={{ homeassistant_service_user }}
Group={{ homeassistant_service_user }}
WorkingDirectory={{ homeassistant_stack_dir }}
Environment=DOCKER_HOST=unix:///run/user/{{ homeassistant_service_uid }}/docker.sock
ExecStart=/usr/bin/docker compose -f {{ homeassistant_stack_dir }}/compose.yml up
ExecStop=/usr/bin/docker compose -f {{ homeassistant_stack_dir }}/compose.yml down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

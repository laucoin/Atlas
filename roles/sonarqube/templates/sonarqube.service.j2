[Unit]
Description=Atlas stack: sonarqube
After=network-online.target docker.service traefik.service
Requires=docker.service

[Service]
Type=simple
User={{ sonarqube_service_user }}
Group={{ sonarqube_service_user }}
WorkingDirectory={{ sonarqube_stack_dir }}
Environment=DOCKER_HOST=unix:///run/user/{{ sonarqube_service_uid }}/docker.sock
ExecStart=/usr/bin/docker compose -f {{ sonarqube_stack_dir }}/compose.yml up
ExecStop=/usr/bin/docker compose -f {{ sonarqube_stack_dir }}/compose.yml down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
